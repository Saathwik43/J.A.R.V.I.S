# Google & Gemini Models
JARVIS_GOOGLE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
JARVIS_GOOGLE_VOICE=Charon
JARVIS_TEMPERATURE=0.8

# Console text pipeline (`python agent.py console`). Voice rooms still use Gemini Live.
# google = Gemini text LLM + Gemini TTS; openai = OpenAI LLM + OpenAI TTS.
# STT for console audio mode uses OpenAI either way (set OPENAI_API_KEY).
JARVIS_LLM_PROVIDER=google
JARVIS_GOOGLE_TEXT_MODEL=gemini-2.5-flash
JARVIS_OPENAI_TEXT_MODEL=gpt-4o-mini

# Memory Configuration (Mem0)
MEM0_USER_ID=your_username           # Used to distinguish your memories
MEM0_API_KEY=your_mem0_key
JARVIS_MEMORY_LIMIT=50               # Max memories injected at session start

# Communication & Noise Cancellation
JARVIS_USE_BVC=true
JARVIS_VIDEO_ENABLED=true

# External Service Integrations
N8N_MCP_SERVER_URL=your_n8n_mcp_url

# Email / Gmail Setup (for the send_email tool — use an App Password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# LiveKit (if not using `lk` CLI defaults)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
